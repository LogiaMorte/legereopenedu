---
import '../styles/global.css';
/*
 * Fontlar self-hosted (CSP dış font'a kapalı) ve DEĞİŞKEN (variable) sürüm:
 * tek dosya 100–900 arası bütün ağırlıkları taşıyor.
 *
 * Önceden her ağırlık ayrı statik dosyaydı — Türkçe sayfa hem `latin` hem
 * `latin-ext` alt kümesini indirdiği için 9 ağırlık 390 KB tutuyordu. Üstelik
 * Inter 700 hiç yüklenmiyordu; gövdedeki `font-bold` (93 kullanım) tarayıcı
 * tarafından sahte kalınlaştırılıyordu. Değişken sürüm 230 KB'a iniyor ve 700
 * gerçek çizimiyle geliyor.
 */
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
/*
 * Hero başlığı LCP öğesi ve başlık fontuyla çiziliyor. Font normalde ancak CSS
 * indirilip ayrıştırıldıktan sonra keşfedilir — bir gidiş-dönüş geç kalır.
 * Bu iki dosya (toplam ~41 KB) baştan istenirse başlık ilk boyada doğru
 * fontuyla geliyor. Türkçe başlıklardaki ı/ş/ğ `latin-ext` alt kümesinde, o
 * yüzden ikisi de gerekli.
 */
import headingLatin from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import headingLatinExt from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-ext-wght-normal.woff2?url';
import { ClientRouter } from 'astro:transitions';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StickyJoin from '../components/StickyJoin.astro';
import RegistrationModal from '../components/RegistrationModal.astro';
import siteConfig from '../data/config.json';

interface Props {
  lang: 'tr' | 'en';
  pageTitle?: string;
  pageDescription?: string;
  noindex?: boolean;
}

const { lang, pageTitle, pageDescription, noindex } = Astro.props;
const isEn = lang === 'en';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const defaultDescription = isEn
  ? 'Legere Open Edu: An independent interdisciplinary academic research network at the intersection of criminology, sociology, philosophy, and data science.'
  : 'Legere Open Edu: Kriminoloji, sosyoloji, felsefe ve veri bilimi kesişiminde bağımsız disiplinlerarası akademik araştırma ağı.';
const description = pageDescription ?? defaultDescription;
const defaultTitle = isEn ? 'Legere | Interdisciplinary Academic Research Network' : 'Legere | Disiplinlerarası Akademik Araştırma Ağı';
const title = pageTitle ? `${pageTitle} | Legere` : defaultTitle;
// Paylaşım kartı görseli (LinkedIn / WhatsApp / X). Mutlak URL zorunlu —
// bu platformlar göreli yolu çözemez. Kaynak: scratchpad/og.svg, sharp ile üretildi.
const ogImage = new URL(isEn ? '/og-image-en.png' : '/og-image.png', Astro.site);

// hreflang sayfa başına hesaplanır. Eskiden her sayfada sabit '/' ve '/en/'
// yazıyordu, yani /ethics/ kendi Türkçe karşılığı olarak ana sayfayı
// gösteriyordu — arama motorlarına yanlış eşleşme bildiriliyordu.
const path = Astro.url.pathname;
const trPath = path.startsWith('/en/') ? path.slice(3) : path === '/en' ? '/' : path;
const enPath = trPath === '/' ? '/en/' : `/en${trPath}`;
// noindex sayfaların (ör. /admin) İngilizce karşılığı yok; alternatif bildirmeyiz.
const showAlternates = !noindex;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0A0A0F" />
  <meta name="color-scheme" content="dark" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/favicon.svg" />
  <link rel="preload" href={headingLatin} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={headingLatinExt} as="font" type="font/woff2" crossorigin />
  <link rel="canonical" href={canonicalUrl} />
  {showAlternates && (
    <>
      <link rel="alternate" hreflang="tr" href={new URL(trPath, Astro.site)} />
      <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />
      <link rel="alternate" hreflang="x-default" href={new URL(trPath, Astro.site)} />
    </>
  )}

  <link rel="preconnect" href="https://accounts.google.com" crossorigin />
  <link rel="preconnect" href="https://apis.google.com" crossorigin />

  <meta name="referrer" content="strict-origin-when-cross-origin" />
  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <meta name="description" content={description} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content={isEn ? 'en_US' : 'tr_TR'} />
  <meta property="og:site_name" content="Legere Open Edu" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={defaultTitle} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- JSON-LD — e-posta @ işareti bilerek \u0040; stringify sonrası tekrar yazılır -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "name": "Legere Open Edu",
    "alternateName": "OWL - Open Workshop Lab",
    "url": "https://legereopenedu.com",
    "email": "INFO_EMAIL_PLACEHOLDER",
    "sameAs": [siteConfig.social.linkedin, siteConfig.social.instagram],
    "description": "Independent interdisciplinary academic research network at the intersection of criminology, sociology, philosophy, and data science.",
    "areaServed": "Global",
    "knowsAbout": ["Criminology", "Sociology", "Philosophy", "Data Science", "Law", "Psychology", "Anthropology"]
  }).replace('INFO_EMAIL_PLACEHOLDER', 'info\\u0040legereopenedu.com')} />

  <title>{title}</title>
  <ClientRouter />
</head>
<body class="bg-bg-primary text-text-primary antialiased overflow-x-hidden">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[200] focus:px-4 focus:py-2 focus:bg-gold-500 focus:text-bg-primary focus:rounded-md focus:font-heading focus:font-bold">
    {isEn ? 'Skip to content' : 'İçeriğe geç'}
  </a>

    <SiteNav lang={lang} />

  <!--
    Cloudflare e-posta gizlemesi: decode script çalışmazsa adres "korumalı e-posta"
    metnine dönüşür. email_off tüm sayfada (yasal metinler + iletişim) adresi
    olduğu gibi bırakır.
  -->
  <!--email_off-->
  <main id="main-content">
    <slot />
  </main>

  <SiteFooter lang={lang} />
  <!--email_on-->
  <RegistrationModal lang={lang} />
  <StickyJoin lang={lang} />

  <!-- Back to Top Button -->
  <button
    id="back-to-top"
    class="fixed bottom-6 right-6 z-40 w-11 h-11 rounded-full flex items-center justify-center opacity-0 pointer-events-none transition-all duration-300 hover:-translate-y-1"
    style="background: linear-gradient(135deg, #B8922E, #D4A843); box-shadow: 0 0 20px rgba(212,168,67,0.25);"
    aria-label={isEn ? 'Back to top' : 'Yukarı dön'}
  >
    <svg class="w-5 h-5 text-bg-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5" />
    </svg>
  </button>

  <!--
    ÖNEMLİ: Bu script'e data-cfasync / başka attribute EKLEME.
    Astro, attribute'lu <script>'i işlemez (is:inline gibi bırakır) ve
    ham `import` SyntaxError verir — login/auth init dahil tüm site JS'i
    etkilenir. Rocket Loader için Cloudflare dashboard'da kapatın.
  -->
  <script>
    import { initSite } from '../scripts/site';

    initSite();
    // ClientRouter DOM'u değiştirdiği için her geçişte yeniden bağlanmalı.
    // initSite kendi dinleyicilerini önce temizler; burada ikinci bir kurulum
    // fonksiyonu TUTMA — "yukarı çık" da site.ts içinde, aynı temizlik
    // mekanizmasına bağlı (yoksa her gezinmede bir scroll dinleyicisi kalıyordu).
    document.addEventListener('astro:after-swap', initSite);
  </script>
</body>
</html>
