---
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/languages';
import ParticleCanvas from '../components/ParticleCanvas.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const signupPath = lang === 'en' ? '/en/signup' : '/signup';
---

<section id="hero" class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <ParticleCanvas />

  <!-- Radial gradient overlay -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_transparent_0%,_#0A0A0F_70%)] z-[1]"></div>

  <!-- Content -->
  <div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
    <!-- Badge -->
    <div class="hero-fade inline-flex items-center gap-2 px-4 py-2 rounded-full glass-subtle mb-8" style="animation: fadeInUp 0.8s ease-out 0.1s both;">
      <span class="w-2 h-2 rounded-full bg-gold-500 animate-pulse"></span>
      <span class="text-sm font-heading text-text-secondary tracking-wide">
        {t('hero.badge')}
      </span>
    </div>

    <!-- Title: LEGERE -->
    <h1
      class="hero-fade mb-4"
      style="animation: fadeInUp 0.8s ease-out 0.2s both;"
    >
      <span class="block text-5xl md:text-7xl lg:text-8xl font-heading font-bold tracking-[0.15em] text-gradient-gold">
        {t('hero.title')}
      </span>
    </h1>

    <!-- Latin meaning -->
    <p
      class="hero-fade text-sm md:text-base text-gold-500/70 font-mono tracking-wider mb-6"
      style="animation: fadeInUp 0.8s ease-out 0.3s both;"
    >
      {t('hero.legere')}
    </p>

    <!-- Subtitle - the core positioning statement -->
    <p
      class="hero-fade text-lg md:text-2xl text-text-primary font-heading font-medium mb-10 max-w-3xl mx-auto leading-snug"
      style="animation: fadeInUp 0.8s ease-out 0.4s both;"
    >
      {t('hero.subtitle')}
    </p>

    <!--
      CTA sırası kasıtlı: birincil buton başvuruya (/signup) gider, keşif ikincile
      düşer. Site bir davet sayfası — gelen ziyaretçinin ilk eylemi katılmak olmalı,
      13 bölümlük sayfanın içine kaydırılmak değil.

      Not: eski 'hero.tagline' paragrafı buradan kaldırıldı — aynı içeriği Programs
      bölümü (programs.owl/seminars/colloquia) çok daha ayrıntılı anlatıyor, ve
      butonun ekranın üst yarısında kalması için bir paragraf yer açmak gerekiyordu.
      i18n anahtarı duruyor; geri istenirse tek satırla geri konur.
    -->
    <div class="hero-fade flex flex-col sm:flex-row items-center justify-center gap-4" style="animation: fadeInUp 0.8s ease-out 0.55s both;">
      <a href={signupPath} class="btn-gold">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zM3 19.235v-.11a6.375 6.375 0 0112.75 0v.109A12.318 12.318 0 019.374 21c-2.331 0-4.512-.645-6.374-1.766z" />
        </svg>
        {t('hero.ctaJoin')}
      </a>
      <a href="#programs" class="btn-outline">
        {t('hero.cta')}
      </a>
    </div>

    <!-- Sürtünme azaltıcı: katılmanın ne kadar kolay olduğunu buton altında söyle -->
    <p
      class="hero-fade mt-5 text-xs md:text-sm text-text-secondary/60 font-mono tracking-wide"
      style="animation: fadeInUp 0.8s ease-out 0.7s both;"
    >
      {t('hero.ctaNote')}
    </p>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10" style="animation: fadeInUp 0.8s ease-out 0.85s both;">
    <a href="#about" class="flex flex-col items-center gap-2 text-text-secondary/50 hover:text-gold-500/70 transition-colors" aria-label="Scroll down">
      <svg class="w-5 h-5" style="animation: scrollDown 2s ease-in-out infinite;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </a>
  </div>
</section>
